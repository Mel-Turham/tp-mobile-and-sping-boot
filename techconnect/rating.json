                    "type": "boolean"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ratings/technician/{technicianId}": {
      "get": {
        "tags": ["Ratings"],
        "summary": "Obtenir toutes les évaluations d'un technicien avec pagination",
        "operationId": "getTechnicianRatings",
        "parameters": [
          {
            "name": "technicianId",
            "in": "path",
            "description": "ID du technicien",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
