    },
    "/api/ratings/technician/{technicianId}/stats": {
      "get": {
        "tags": ["Ratings"],
        "summary": "Obtenir les statistiques d'évaluation d'un technicien",
        "operationId": "getTechnicianRatingStats",
        "parameters": [
          {
            "name": "technicianId",
            "in": "path",
            "description": "ID du technicien",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistiques des évaluations",
            "content": {
