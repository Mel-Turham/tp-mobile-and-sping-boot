  "paths": {
    "/api/ratings/{ratingId}": {
      "get": {
        "tags": ["Ratings"],
        "summary": "Obtenir une évaluation par son ID",
        "operationId": "getRatingById",
        "parameters": [
          {
            "name": "ratingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Évaluation trouvée",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Évaluation non trouvée",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Ratings"],
        "summary": "Mettre à jour une évaluation existante",
        "operationId": "updateRating",
        "parameters": [
          {
            "name": "ratingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RatingUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "Évaluation non trouvée",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "403": {
            "description": "Non autorisé à modifier cette évaluation",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "200": {
            "description": "Évaluation mise à jour avec succès",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Ratings"],
        "summary": "Supprimer une évaluation",
        "operationId": "deleteRating",
        "parameters": [
          {
            "name": "ratingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Non autorisé à supprimer cette évaluation"
          },
          "404": {
            "description": "Évaluation non trouvée"
          },
          "204": {
            "description": "Évaluation supprimée avec succès"
          },
          "401": {
            "description": "Non authentifié"
          }
        }
      }
    },
    "/api/ratings": {
      "post": {
        "tags": ["Ratings"],
        "summary": "Créer une évaluation pour un technicien",
        "operationId": "createRating",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RatingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Non authentifié",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Technicien non trouvé",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "201": {
            "description": "Évaluation créée avec succès",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides ou évaluation déjà existante",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RatingResponse"
                }
              }
            }
          }
        }
      }
    },
